{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "node tools/build.mjs",
        "test:portable": "node tools/smoke-portable.mjs",
        "dev": "node tools/dev.mjs --app",
        "build:ui": "node tools/build-ui.mjs",
        "dev:ui": "node tools/dev.mjs",
        "dev:app": "node tools/run-example.mjs",
        "test": "pnpm run test:types && pnpm run test:solid && pnpm run test:features && pnpm run test:bridge && pnpm run test:refresh && pnpm run test:tree && pnpm run test:select && pnpm run test:packages && pnpm run test:css && pnpm run test:hover && pnpm run test:examples",
        "test:types": "tsc -p tests/types/tsconfig.json",
        "test:solid": "node --conditions=browser --conditions=development tests/solid-stable.mjs",
        "test:solid:native": "node tools/test-solid-stable-native.mjs",
        "test:hover": "node tools/generate-frame-inputs.mjs --check && node --conditions=browser --conditions=development tests/hover.mjs && node --conditions=browser --conditions=development tests/bridge-phases.mjs && node --conditions=browser --conditions=development tests/css-dependencies.mjs --check && node --conditions=browser --conditions=development tests/change-discovery.mjs",
        "test:hover:native": "node tools/smoke-native.mjs --hover",
        "test:frames:native": "node tools/test-frame-scheduling.mjs",
        "test:examples": "node tests/examples.mjs",
        "test:css": "node --conditions=browser tests/css-files.mjs",
        "test:css:dev": "node --conditions=browser --conditions=development tests/css-dev.mjs",
        "test:css:bundle": "pnpm build:ui --example css && node --conditions=browser tests/css-bundle.mjs",
        "test:packages": "node packages/solid-zig/tests/text-overflow.mjs && node packages/solid-zig/tests/box-style.mjs && node packages/solid-zig/tests/flex-block.mjs && node packages/solid-zig/tests/phase-e-css.mjs",
        "test:features": "node --conditions=browser tests/features_probe.mjs",
        "test:bridge": "node --conditions=browser --conditions=development tests/bridge_probe.mjs",
        "test:refresh": "node --conditions=browser --conditions=development tests/refresh_probe.mjs",
        "test:tree": "node --conditions=browser --conditions=development tests/tree_probe.mjs",
        "test:select": "node --conditions=browser --conditions=development packages/solid-zig/tests/select-control.mjs",
        "setup": "node tools/setup.mjs",
        "test:native": "zig build test-native",
        "test:runtime": "zig build test-runtime -Ddriver=true",
        "test:driver": "node tools/test-clock-driver.mjs",
        "test:smoke": "node tools/smoke-native.mjs"
    },
    "dependencies": {
        "@solidjs/universal": "2.0.0",
        "solid-js": "2.0.0"
    },
    "devDependencies": {
        "@babel/core": "8.1.0",
        "@babel/plugin-transform-modules-commonjs": "8.0.1",
        "@solidjs/signals": "2.0.0",
        "@solidjs/vite-plugin": "3.0.0",
        "@solidjs/web": "2.0.0",
        "cssstyle": "6.2.0",
        "lightningcss": "1.33.0",
        "postcss": "8.5.32",
        "typescript": "5.9.3",
        "vite": "8.3.7"
    }
}
